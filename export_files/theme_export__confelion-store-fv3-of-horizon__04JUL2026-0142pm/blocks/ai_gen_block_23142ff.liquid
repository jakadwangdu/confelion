{% doc %}
  @prompt
    Create a curated product showcase section for a clothing brand named CONFELION.
    
    Layout:
    
    Mobile & desktop: 2 columns
    
    2 rows only
    
    Total 2 products (manually selectable)
    
    Equal card sizes
    
    Each product card includes:
    
    Product image (square or 4:5 ratio)
    
    Red “Sale” label at top-left
    
    Product title below image
    
    Sale price bold + original price crossed
    
    Style:
    
    Clean white background
    
    Minimal spacing
    
    No borders, no shadows
    
    Interaction:
    
    Subtle image zoom on hover/tap
    
    No sliders
    
    No autoplay
    
    Admin Control:
    
    Allow manual product selection (choose any 4 products)
    
    Responsive:
    
    Same 2x1 layout on mobile and desktop, make it display all products in a 2x grid , allow us to choose a collection and this displays all products from that collection
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 0;
  }

  .ai-product-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.gap }}px;
    max-width: 100%;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-card-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-sale-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: {{ block.settings.sale_badge_color }};
    color: {{ block.settings.sale_badge_text_color }};
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    z-index: 1;
  }

  .ai-product-card-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 400;
    color: #000000;
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.price_size }}px;
  }

  .ai-sale-price-{{ ai_gen_id }} {
    font-weight: 700;
    color: #000000;
  }

  .ai-original-price-{{ ai_gen_id }} {
    text-decoration: line-through;
    color: #999999;
    font-weight: 400;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px 20px;
    color: #666666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-product-card-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<curated-showcase-{{ ai_gen_id }} class="ai-product-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-showcase-grid-{{ ai_gen_id }}">
    {% if block.settings.collection != blank %}
      {% assign collection = block.settings.collection %}
      {% assign products_to_show = block.settings.products_limit %}
      
      {% for product in collection.products limit: products_to_show %}
        <a href="{{ product.url }}" class="ai-product-card-{{ ai_gen_id }}">
          <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
            {% if product.compare_at_price > product.price %}
              <div class="ai-sale-badge-{{ ai_gen_id }}">Sale</div>
            {% endif %}

            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-product-card-image-{{ ai_gen_id }}"
                loading="lazy"
                width="800"
                height="800"
              >
            {% else %}
              <div class="ai-product-card-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-product-card-info-{{ ai_gen_id }}">
            <h3 class="ai-product-card-title-{{ ai_gen_id }}">{{ product.title }}</h3>
            <div class="ai-product-card-price-{{ ai_gen_id }}">
              <span class="ai-sale-price-{{ ai_gen_id }}">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="ai-original-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      <div class="ai-empty-state-{{ ai_gen_id }}">
        Select a collection to display products
      </div>
    {% endif %}
  </div>
</curated-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class CuratedShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('curated-showcase-{{ ai_gen_id }}', CuratedShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection showcase",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 2,
      "max": 50,
      "step": 2,
      "default": 10
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between products",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Content spacing",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Sale badge"
    },
    {
      "type": "color",
      "id": "sale_badge_color",
      "label": "Background",
      "default": "#FF0000"
    },
    {
      "type": "color",
      "id": "sale_badge_text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Collection showcase"
    }
  ]
}
{% endschema %}
