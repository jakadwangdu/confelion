mportant;}"," \/* Hover effect *\/.footer__utilities a:hover,.footer-utilities a:hover,.utilities a:hover {color: #ffffff !important;}"," \/* Divider \/ border light *\/.footer__utilities hr,.footer-utilities hr {border-color: rgba(255, 255, 255, 0.1);}"],"name":"t:names.utilities","settings":{"section_width":"page-width","gap":24,"divider_thickness":0,"color_scheme":"","padding-block-start":20,"padding-block-end":48}},"custom_liquid_MgpcPD":{"type":"custom-liquid","custom_css":[".brand-footer-bottom {background: #242424; padding: 28px 12px; text-align: center;}",".pay-icons {margin-bottom: 14px;}",".pay-badge {display: inline-block; padding: 4px 14px; margin: 0 1px; background: #2f2f2f; border-radius: 2px; color: #e0e0e0; font-size: 12px; font-weight: 500;}",".brand-footer-links a {color: #cfcfcf; font-size: 13px; text-decoration: none;}",".brand-footer-copy {margin-top: 2px; font-size: 15px; color: #a8a8a8;}"],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<!-- FLOATING GLASS FOOTER -->\n<div class=\"floating-footer\">\n  \n  <a href=\"\/\" class=\"footer-item active\">\n    <span class=\"icon\">\n      <svg viewBox=\"0 0 24 24\">\n        <path d=\"M3 10L12 3l9 7v10a1 1 0 0 1-1 1h-6v-6H10v6H4a1 1 0 0 1-1-1z\"\/>\n      <\/svg>\n    <\/span>\n    <span class=\"label\">Home<\/span>\n  <\/a>\n\n  <a href=\"\/search\" class=\"footer-item\">\n    <span class=\"icon\">\n      <svg viewBox=\"0 0 24 24\">\n        <circle cx=\"11\" cy=\"11\" r=\"7\"\/>\n        <line x1=\"16.5\" y1=\"16.5\" x2=\"21\" y2=\"21\"\/>\n      <\/svg>\n    <\/span>\n    <span class=\"label\">Search<\/span>\n  <\/a>\n\n  <a href=\"\/collections\/all\" class=\"footer-item\">\n    <span class=\"icon\">\n      <svg viewBox=\"0 0 24 24\">\n        <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"\/>\n        <rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"\/>\n        <rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"\/>\n        <rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"\/>\n      <\/svg>\n    <\/span>\n    <span class=\"label\">Collection<\/span>\n  <\/a>\n\n  <a href=\"\/account\" class=\"footer-item\">\n    <span class=\"icon\">\n      <svg viewBox=\"0 0 24 24\">\n        <circle cx=\"12\" cy=\"8\" r=\"4\"\/>\n        <path d=\"M4 20c2-4 14-4 16 0\"\/>\n      <\/svg>\n    <\/span>\n    <span class=\"label\">Account<\/span>\n  <\/a>\n\n  <a href=\"\/cart\" class=\"footer-item cart-item\">\n    <span class=\"icon\">\n      <svg viewBox=\"0 0 24 24\">\n        <circle cx=\"9\" cy=\"20\" r=\"1\"\/>\n        <circle cx=\"17\" cy=\"20\" r=\"1\"\/>\n        <path d=\"M2 2h4l2.5 12h10l2-8H6\"\/>\n      <\/svg>\n    <\/span>\n    <span class=\"label\">Cart<\/span>\n    <span class=\"cart-count\" id=\"cart-count\">0<\/span>\n  <\/a>\n\n<\/div>\n\n<style>\n.floating-footer {\n  position: fixed;\n  bottom: 12px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 92%;\n  max-width: 500px;\n  height: 65px;\n\n  display: flex;\n  justify-content: space-around;\n  align-items: center;\n\n  border-radius: 18px;\n\n  background: rgba(255, 255, 255, 0.6);\n  backdrop-filter: blur(12px);\n  -webkit-backdrop-filter: blur(12px);\n\n  box-shadow: \n    0 8px 30px rgba(0,0,0,0.1),\n    inset 0 1px rgba(255,255,255,0.3);\n\n  z-index: 9999;\n}\n\n.footer-item {\n  text-decoration: none;\n  color: #444;\n  font-size: 11px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  position: relative;\n  transition: all 0.25s ease;\n}\n\n.footer-item svg {\n  width: 20px;\n  height: 20px;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  fill: none;\n  margin-bottom: 3px;\n  transition: all 0.25s ease;\n}\n\n\/* Hover \/ Tap Effect *\/\n.footer-item:active {\n  transform: scale(0.92);\n}\n\n\/* Active State *\/\n.footer-item.active {\n  color: #000;\n}\n\n.footer-item.active svg {\n  stroke: #000;\n}\n\n\/* Cart Badge *\/\n.cart-item {\n  position: relative;\n}\n\n.cart-count {\n  position: absolute;\n  top: -3px;\n  right: -8px;\n  background: red;\n  color: #fff;\n  font-size: 10px;\n  padding: 2px 5px;\n  border-radius: 50%;\n  font-weight: bold;\n}\n\n\/* Prevent content overlap *\/\nbody {\n  padding-bottom: 90px;\n}\n<\/style>\n\n<script>\nfunction updateCartCount() {\n  fetch('\/cart.js')\n    .then(res => res.json())\n    .then(data => {\n      document.getElementById('cart-count').innerText = data.item_count;\n    });\n}\nupdateCartCount();\n\n\/* Active tab detection *\/\nconst links = document.querySelectorAll('.footer-item');\nlinks.forEach(link => {\n  if (link.href === window.location.href) {\n    link.classList.add('active');\n  }\n});\n<\/script>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_gxVQYf":{"type":"custom-liquid","custom_css":[".brand-footer-bottom {background: #242424; padding: 28px 12px; text-align: center;}",".pay-icons {margin-bottom: 14px;}",".pay-badge {display: inline-block; padding: 4px 14px; margin: 0 1px; background: #2f2f2f; border-radius: 2px; color: #e0e0e0; font-size: 12px; font-weight: 500;}",".brand-footer-links a {color: #cfcfcf; font-size: 13px; text-decoration: none;}",".brand-footer-copy {margin-top: 2px; font-size: 15px; color: #a8a8a8;}"],"name":"t:names.custom_liquid","settings":{"custom_liquid":"<style>\n\/* =========================\n   CONFELION SUPPORT WIDGET\n   Scoped so it won't affect the Shopify header\/page\n========================= *\/\n\n.cf-widget, .cf-widget *{\n  box-sizing:border-box;\n  margin:0;\n  padding:0;\n}\n\n.cf-widget{\n  font-family:'Outfit',sans-serif;\n  position:fixed;\n  inset:0;\n  pointer-events:none;\n  z-index:2147483647;\n}\n\n\/* VARIABLES *\/\n.cf-widget{\n  --g-bg:rgba(255,255,255,0.55);\n  --g-surface:rgba(255,255,255,0.72);\n  --g-surface2:rgba(255,255,255,0.45);\n  --g-border:rgba(255,255,255,0.7);\n  --g-border2:rgba(200,210,225,0.5);\n  --g-blur:blur(22px) saturate(1.6);\n  --g-text:#1a2332;\n  --g-text-mid:#4a5568;\n  --g-text-dim:#8a98ab;\n  --g-accent:#2b6cb0;\n  --g-accent-light:#ebf4ff;\n  --g-bot-bubble:rgba(255,255,255,0.82);\n  --g-user-bubble:rgba(43,108,176,0.9);\n  --g-shadow:0 24px 64px rgba(30,60,100,.18),0 4px 20px rgba(30,60,100,.1),0 1px 0 rgba(255,255,255,.9) inset;\n  --g-radius:20px;\n  --g-w:330px;\n  --g-h:490px;\n}\n\n\/* TOGGLE BUTTON *\/\n#cf-toggle{\n  position:fixed;\n  bottom:100px;\n  right:22px;\n  width:50px;\n  height:50px;\n  border-radius:50%;\n  background:var(--g-surface);\n  backdrop-filter:var(--g-blur);\n  -webkit-backdrop-filter:var(--g-blur);\n  border:1.5px solid var(--g-border);\n  box-shadow:0 8px 32px rgba(30,60,100,.2),0 2px 8px rgba(30,60,100,.12),0 1px 0 rgba(255,255,255,.9) inset;\n  cursor:pointer;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  z-index:2147483647;\n  pointer-events:auto;\n  transition:transform .28s cubic-bezier(.34,1.56,.64,1),box-shadow .25s ease;\n  animation:cf-pop-in .5s .7s cubic-bezier(.34,1.56,.64,1) both;\n}\n@keyframes cf-pop-in{\n  from{transform:scale(0) rotate(-20deg);opacity:0}\n  to{transform:scale(1) rotate(0deg);opacity:1}\n}\n#cf-toggle:hover{\n  transform:scale(1.1);\n  box-shadow:0 12px 40px rgba(30,60,100,.28),0 4px 14px rgba(30,60,100,.16),0 1px 0 rgba(255,255,255,.9) inset;\n}\n#cf-toggle .cf-icon-chat,\n#cf-toggle .cf-icon-close{\n  position:absolute;\n  transition:opacity .2s,transform .25s cubic-bezier(.34,1.56,.64,1);\n}\n#cf-toggle .cf-icon-close{opacity:0;transform:rotate(-45deg) scale(.8)}\n#cf-toggle.open .cf-icon-chat{opacity:0;transform:rotate(45deg) scale(.7)}\n#cf-toggle.open .cf-icon-close{opacity:1;transform:rotate(0deg) scale(1)}\n\n.cf-notif{\n  position:absolute;\n  top:5px;\n  right:5px;\n  width:9px;\n  height:9px;\n  border-radius:50%;\n  background:#ef4444;\n  border:2px solid rgba(255,255,255,.9);\n  animation:cf-ping 2s ease-in-out infinite;\n  transition:opacity .2s;\n}\n#cf-toggle.open .cf-notif{opacity:0}\n@keyframes cf-ping{\n  0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.45)}\n  50%{box-shadow:0 0 0 5px rgba(239,68,68,0)}\n}\n\n\/* PANEL *\/\n#cf-panel{\n  position:fixed;\n  bottom:162px;\n  right:22px;\n  width:var(--g-w);\n  max-height:var(--g-h);\n  background:var(--g-bg);\n  backdrop-filter:var(--g-blur);\n  -webkit-backdrop-filter:var(--g-blur);\n  border:1.5px solid var(--g-border);\n  border-radius:var(--g-radius);\n  box-shadow:var(--g-shadow);\n  z-index:2147483646;\n  display:flex;\n  flex-direction:column;\n  overflow:hidden;\n  transform-origin:bottom right;\n  transform:scale(.85) translateY(16px);\n  opacity:0;\n  pointer-events:none;\n  transition:transform .38s cubic-bezier(.34,1.28,.64,1),opacity .28s ease;\n}\n#cf-panel::before{\n  content:'';\n  position:absolute;\n  inset:0;\n  border-radius:var(--g-radius);\n  background:linear-gradient(135deg,rgba(255,255,255,.35) 0%,rgba(255,255,255,0) 60%);\n  pointer-events:none;\n  z-index:0;\n}\n#cf-panel.open{\n  transform:scale(1) translateY(0);\n  opacity:1;\n  pointer-events:auto;\n}\n\n\/* HEADER *\/\n.cf-header{\n  position:relative;\n  z-index:1;\n  padding:13px 14px 12px;\n  background:rgba(255,255,255,.5);\n  backdrop-filter:blur(8px);\n  border-bottom:1px solid var(--g-border2);\n  display:flex;\n  align-items:center;\n  gap:10px;\n  flex-shrink:0;\n}\n.cf-avatar{\n  width:36px;\n  height:36px;\n  border-radius:50%;\n  background:rgba(255,255,255,.95);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  flex-shrink:0;\n  overflow:hidden;\n  box-shadow:0 4px 12px rgba(43,108,176,.18);\n}\n.cf-avatar img{\n  width:100%;\n  height:100%;\n  object-fit:contain;\n  display:block;\n}\n.cf-header-name{\n  font-family:'Playfair Display',serif;\n  font-size:.95rem;\n  font-weight:600;\n  color:var(--g-text);\n  letter-spacing:.01em;\n  line-height:1.2;\n}\n.cf-header-status{\n  font-size:.66rem;\n  color:var(--g-text-dim);\n  display:flex;\n  align-items:center;\n  gap:4px;\n  margin-top:2px;\n}\n.cf-status-dot{\n  width:6px;\n  height:6px;\n  border-radius:50%;\n  background:#22c55e;\n  flex-shrink:0;\n  animation:cf-blink 2.4s ease-in-out infinite;\n}\n@keyframes cf-blink{0%,100%{opacity:1}50%{opacity:.4}}\n.cf-close-btn{\n  margin-left:auto;\n  width:26px;\n  height:26px;\n  border-radius:50%;\n  background:rgba(30,60,100,.06);\n  border:1px solid rgba(30,60,100,.08);\n  cursor:pointer;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  color:var(--g-text-dim);\n  transition:all .2s;\n  flex-shrink:0;\n}\n.cf-close-btn:hover{background:rgba(30,60,100,.12);color:var(--g-text)}\n\n\/* MESSAGES *\/\n.cf-messages{\n  position:relative;\n  z-index:1;\n  flex:1;\n  overflow-y:auto;\n  padding:13px 11px 10px;\n  display:flex;\n  flex-direction:column;\n  gap:7px;\n  scroll-behavior:smooth;\n}\n.cf-messages::-webkit-scrollbar{width:3px}\n.cf-messages::-webkit-scrollbar-track{background:transparent}\n.cf-messages::-webkit-scrollbar-thumb{background:rgba(43,108,176,.15);border-radius:4px}\n\n\/* BUBBLES *\/\n.cf-bubble{\n  max-width:85%;\n  padding:9px 12px;\n  border-radius:14px;\n  font-size:.78rem;\n  line-height:1.58;\n  animation:cf-rise .26s cubic-bezier(.22,.61,.36,1) both;\n}\n@keyframes cf-rise{\n  from{opacity:0;transform:translateY(10px)}\n  to{opacity:1;transform:translateY(0)}\n}\n.cf-bubble.bot{\n  background:var(--g-bot-bubble);\n  color:var(--g-text);\n  border-radius:5px 14px 14px 14px;\n  border:1px solid rgba(200,215,235,.6);\n  align-self:flex-start;\n  box-shadow:0 2px 12px rgba(30,60,100,.08);\n}\n.cf-bubble.user{\n  background:var(--g-user-bubble);\n  color:#fff;\n  border-radius:14px 14px 5px 14px;\n  align-self:flex-end;\n  box-shadow:0 4px 16px rgba(43,108,176,.25);\n  font-weight:400;\n}\n\n\/* TYPING *\/\n.cf-typing{\n  display:flex;\n  align-items:center;\n  gap:4px;\n  padding:10px 13px;\n  background:var(--g-bot-bubble);\n  border:1px solid rgba(200,215,235,.6);\n  border-radius:5px 14px 14px 14px;\n  align-self:flex-start;\n  box-shadow:0 2px 12px rgba(30,60,100,.08);\n  animation:cf-rise .22s ease both;\n}\n.cf-dot-p{\n  width:5px;\n  height:5px;\n  border-radius:50%;\n  background:var(--g-accent);\n  opacity:.5;\n}\n.cf-dot-p:nth-child(1){animation:cf-dots .85s 0s ease-in-out infinite}\n.cf-dot-p:nth-child(2){animation:cf-dots .85s .17s ease-in-out infinite}\n.cf-dot-p:nth-child(3){animation:cf-dots .85s .34s ease-in-out infinite}\n@keyframes cf-dots{\n  0%,80%,100%{transform:scale(.65);opacity:.35}\n  40%{transform:scale(1);opacity:1}\n}\n\n\/* MENU BUTTONS *\/\n.cf-menu-wrap{\n  display:flex;\n  flex-direction:column;\n  gap:5px;\n  align-self:flex-start;\n  width:88%;\n  animation:cf-rise .3s .05s ease both;\n}\n.cf-mbtn{\n  padding:8px 12px;\n  background:rgba(255,255,255,.7);\n  backdrop-filter:blur(8px);\n  border:1px solid rgba(200,215,235,.65);\n  border-radius:10px;\n  color:var(--g-text-mid);\n  font-family:'Outfit',sans-serif;\n  font-size:.74rem;\n  font-weight:500;\n  cursor:pointer;\n  text-align:left;\n  transition:all .2s;\n  display:flex;\n  align-items:center;\n  gap:7px;\n  box-shadow:0 1px 4px rgba(30,60,100,.05);\n}\n.cf-mbtn:hover{\n  background:rgba(255,255,255,.92);\n  border-color:rgba(43,108,176,.3);\n  color:var(--g-accent);\n  transform:translateX(3px);\n  box-shadow:0 3px 12px rgba(43,108,176,.1);\n}\n.cf-mbtn .em{font-size:.85rem;flex-shrink:0}\n.cf-mbtn .arr{margin-left:auto;opacity:.35;font-size:.65rem}\n\n\/* BACK BUTTON *\/\n.cf-back-wrap{\n  align-self:flex-start;\n  animation:cf-rise .28s ease both;\n}\n.cf-back-btn{\n  display:inline-flex;\n  align-items:center;\n  gap:5px;\n  padding:5px 11px;\n  background:rgba(30,60,100,.05);\n  border:1px solid rgba(30,60,100,.1);\n  border-radius:20px;\n  color:var(--g-text-dim);\n  font-size:.68rem;\n  font-weight:500;\n  font-family:'Outfit',sans-serif;\n  cursor:pointer;\n  transition:all .18s;\n  letter-spacing:.01em;\n}\n.cf-back-btn:hover{\n  background:rgba(43,108,176,.07);\n  border-color:rgba(43,108,176,.2);\n  color:var(--g-accent);\n}\n\n\/* EMAIL BUTTON *\/\n.cf-email-btn{\n  display:inline-flex;\n  align-items:center;\n  gap:6px;\n  padding:7px 13px;\n  background:rgba(43,108,176,.07);\n  border:1px solid rgba(43,108,176,.2);\n  border-radius:20px;\n  color:var(--g-accent);\n  font-size:.72rem;\n  font-weight:500;\n  font-family:'Outfit',sans-serif;\n  cursor:pointer;\n  text-decoration:none;\n  transition:all .2s;\n  align-self:flex-start;\n  animation:cf-rise .28s ease both;\n}\n.cf-email-btn:hover{background:rgba(43,108,176,.13);border-color:rgba(43,108,176,.35)}\n\n\/* DIVIDER LABEL *\/\n.cf-divider{\n  align-self:center;\n  font-size:.62rem;\n  color:var(--g-text-dim);\n  letter-spacing:.06em;\n  text-transform:uppercase;\n  padding:2px 0 4px;\n  animation:cf-rise .25s ease both;\n}\n\n\/* FOOTER *\/\n.cf-footer{\n  position:relative;\n  z-index:1;\n  padding:7px 12px;\n  border-top:1px solid var(--g-border2);\n  background:rgba(255,255,255,.35);\n  text-align:center;\n  flex-shrink:0;\n}\n.cf-footer a{\n  font-size:.59rem;\n  color:var(--g-text-dim);\n  letter-spacing:.04em;\n  text-decoration:none;\n}\n.cf-footer a:hover{\n  color:var(--g-accent);\n  text-decoration:underline;\n}\n\n\/* MOBILE *\/\n@media(max-width:420px){\n  .cf-widget{--g-w:calc(100vw - 28px)}\n  #cf-panel{right:14px;bottom:150px}\n  #cf-toggle{bottom:92px;right:14px}\n}\n<\/style>\n\n<div class=\"cf-widget\" id=\"cf-widget\">\n  <!-- TOGGLE -->\n  <button id=\"cf-toggle\" aria-label=\"Open support chat\">\n    <div class=\"cf-notif\"><\/div>\n    <svg class=\"cf-icon-chat\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\">\n      <path d=\"M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z\" fill=\"none\" stroke=\"#2b6cb0\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\/>\n      <circle cx=\"9\" cy=\"10\" r=\"1\" fill=\"#2b6cb0\"\/>\n      <circle cx=\"12\" cy=\"10\" r=\"1\" fill=\"#2b6cb0\"\/>\n      <circle cx=\"15\" cy=\"10\" r=\"1\" fill=\"#2b6cb0\"\/>\n    <\/svg>\n    <svg class=\"cf-icon-close\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2b6cb0\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n      <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"\/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"\/>\n    <\/svg>\n  <\/button>\n\n  <!-- PANEL -->\n  <div id=\"cf-panel\" role=\"dialog\" aria-label=\"Confelion Support\">\n    <div class=\"cf-header\">\n      <div class=\"cf-avatar\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0800\/0313\/7790\/files\/ChatGPT_Image_Jan_31_2026_08_50_36_PM_1.png?v=1777555896\"\n          alt=\"Confelion logo\"\n        \/>\n      <\/div>\n      <div>\n        <div class=\"cf-header-name\">Confelion Support<\/div>\n        <div class=\"cf-header-status\">\n          <span class=\"cf-status-dot\"><\/span>\n          Online · Here to help\n        <\/div>\n      <\/div>\n      <button class=\"cf-close-btn\" id=\"cf-close-btn\" aria-label=\"Close\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"\/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"\/>\n        <\/svg>\n      <\/button>\n    <\/div>\n\n    <div class=\"cf-messages\" id=\"cf-messages\"><\/div>\n\n    <div class=\"cf-footer\">\n      <a href=\"https:\/\/readyflow.in\" target=\"_blank\" rel=\"noopener noreferrer\">Powered by Readyflow<\/a>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\nconst SUPPORT_EMAIL = 'ffeyesgamer6392@gmail.com';\nlet isOpen = false, greeted = false;\n\nconst toggle = document.getElementById('cf-toggle');\nconst panel = document.getElementById('cf-panel');\nconst msgs = document.getElementById('cf-messages');\nconst closeBtn = document.getElementById('cf-close-btn');\n\nfunction openChat(){\n  isOpen = true;\n  panel.classList.add('open');\n  toggle.classList.add('open');\n  if(!greeted){ greeted = true; doGreet(); }\n}\nfunction closeChat(){\n  isOpen = false;\n  panel.classList.remove('open');\n  toggle.classList.remove('open');\n}\ntoggle.addEventListener('click', ()=> isOpen ? closeChat() : openChat());\ncloseBtn.addEventListener('click', closeChat);\n\nconst wait = ms => new Promise(r => setTimeout(r, ms));\n\nfunction scrollDown(){\n  setTimeout(() => msgs.scrollTop = msgs.scrollHeight, 60);\n}\n\nfunction showTyping(){\n  const el = document.createElement('div');\n  el.className = 'cf-typing';\n  el.id = 'cf-typing';\n  el.innerHTML = '<div class=\"cf-dot-p\"><\/div><div class=\"cf-dot-p\"><\/div><div class=\"cf-dot-p\"><\/div>';\n  msgs.appendChild(el);\n  scrollDown();\n  return el;\n}\nfunction removeTyping(){\n  const t = document.getElementById('cf-typing');\n  if(t) t.remove();\n}\n\nasync function bubble(html, who='bot', del=0){\n  if(del) await wait(del);\n  const el = document.createElement('div');\n  el.className = `cf-bubble ${who}`;\n  el.innerHTML = html;\n  msgs.appendChild(el);\n  scrollDown();\n  return el;\n}\n\nfunction addMenu(items, del=0){\n  return new Promise(res => {\n    setTimeout(() => {\n      const wrap = document.createElement('div');\n      wrap.className = 'cf-menu-wrap';\n      items.forEach(item => {\n        const btn = document.createElement('button');\n        btn.className = 'cf-mbtn';\n        btn.innerHTML = `<span class=\"em\">${item.icon}<\/span><span>${item.label}<\/span><span class=\"arr\">›<\/span>`;\n        btn.addEventListener('click', () => {\n          wrap.querySelectorAll('.cf-mbtn').forEach(b => {\n            b.style.opacity = '.3';\n            b.style.pointerEvents = 'none';\n          });\n          btn.style.opacity = '1';\n          btn.style.borderColor = 'rgba(43,108,176,.35)';\n          btn.style.color = 'var(--g-accent)';\n          item.action();\n        });\n        wrap.appendChild(btn);\n      });\n      msgs.appendChild(wrap);\n      scrollDown();\n      res(wrap);\n    }, del);\n  });\n}\n\nfunction addBack(del=0, label='↩ Back to menu', fn=null){\n  return new Promise(res => {\n    setTimeout(() => {\n      const wrap = document.createElement('div');\n      wrap.className = 'cf-back-wrap';\n      const btn = document.createElement('button');\n      btn.className = 'cf-back-btn';\n      btn.innerHTML = `<svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><polyline points=\"15 18 9 12 15 6\"\/><\/svg>${label}`;\n      btn.addEventListener('click', () => {\n        btn.style.pointerEvents = 'none';\n        (fn || showMainMenu)();\n      });\n      wrap.appendChild(btn);\n      msgs.appendChild(wrap);\n      scrollDown();\n      res(wrap);\n    }, del);\n  });\n}\n\nfunction addEmail(del=0){\n  return new Promise(res => {\n    setTimeout(() => {\n      const a = document.createElement('a');\n      a.className = 'cf-email-btn';\n      a.href = `mailto:${SUPPORT_EMAIL}`;\n      a.innerHTML = `<svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z\"\/><polyline points=\"22,6 12,12 2,6\"\/><\/svg>Send an email`;\n      msgs.appendChild(a);\n      scrollDown();\n      res(a);\n    }, del);\n  });\n}\n\nasync function doGreet(){\n  showTyping();\n  await wait(950);\n  removeTyping();\n  await bubble(`Hii, welcome to <strong>Confelion<\/strong> 👋`);\n  showTyping();\n  await wait(700);\n  removeTyping();\n  await bubble(`I'm your personal support assistant. Let me know how I can help!`);\n  showMainMenu(250);\n}\n\nasync function showMainMenu(del=180){\n  await wait(del);\n  await bubble(`How can I help you today?`);\n  addMenu([\n    { icon:'📦', label:'Track my order',        action: doTrackOrder   },\n    { icon:'🛍️', label:'Shopping help',        action: doShoppingHelp },\n    { icon:'💳', label:'Payments & refunds',   action: doPayments     },\n    { icon:'🚚', label:'Shipping information', action: doShipping     },\n    { icon:'🔄', label:'Returns & exchanges',  action: doReturns      },\n    { icon:'✉️', label:'Contact support',      action: doContact      },\n  ], 100);\n}\n\nasync function doTrackOrder(){\n  await bubble('Track my order','user');\n  showTyping(); await wait(1000); removeTyping();\n  await bubble(`Your order is on its way! 🚚`);\n  showTyping(); await wait(600); removeTyping();\n  await bubble(`Delivery typically takes <strong>5–7 business days<\/strong> from dispatch. Please allow a little patience while your order travels to you.`);\n  showTyping(); await wait(500); removeTyping();\n  await bubble(`If it has been more than 7 days, feel free to reach out and we'll look into it right away.`);\n  await addEmail(200);\n  addBack(300);\n}\n\nasync function doShoppingHelp(){\n  await bubble('Shopping help','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Of course! What can I help you with?`);\n  addMenu([\n    { icon:'📐', label:'Finding the right size',   action: doSizeGuide    },\n    { icon:'🔍', label:'Is a product available?', action: doAvailability },\n    { icon:'🎁', label:'Gift wrapping options',   action: doGiftWrapping },\n    { icon:'💡', label:'Product care & materials', action: doProductCare  },\n  ], 120);\n  addBack(220, '↩ Back to main menu', showMainMenu);\n}\nasync function doSizeGuide(){\n  await bubble('Finding the right size','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`All Confelion pieces are true to size and designed with a relaxed, elevated fit.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`You'll find a detailed size chart on each product page — just scroll below the images. If you're between sizes, we recommend sizing up for a relaxed silhouette.`);\n  addBack(250);\n}\nasync function doAvailability(){\n  await bubble('Product availability','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Our collections are curated in limited quantities to maintain quality.`);\n  showTyping(); await wait(500); removeTyping();\n  await bubble(`If an item is out of stock, you can use the <strong>Notify Me<\/strong> button on the product page — we'll email you the moment it's restocked!`);\n  addBack(250);\n}\nasync function doGiftWrapping(){\n  await bubble('Gift wrapping options','user');\n  showTyping(); await wait(850); removeTyping();\n  await bubble(`Yes! We offer complimentary gift wrapping on all orders. 🎁`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`Simply select <strong>\"Add gift wrap\"<\/strong> at checkout. You can also add a personalised message card at no extra cost.`);\n  addBack(250);\n}\nasync function doProductCare(){\n  await bubble('Product care & materials','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Confelion pieces are crafted from premium natural and blended fabrics — linen, merino, vegan leather, and cotton twills.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`Care instructions are on the label inside each item. As a general rule: <strong>cold wash, air dry, avoid tumble drying<\/strong> to preserve the fit and feel.`);\n  addBack(250);\n}\n\nasync function doPayments(){\n  await bubble('Payments & refunds','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Sure! Which part can I help you with?`);\n  addMenu([\n    { icon:'💳', label:'Accepted payment methods', action: doPaymentMethods },\n    { icon:'🔄', label:'How to request a refund', action: doRefundPolicy   },\n    { icon:'❌', label:'Cancel an order',         action: doCancelOrder    },\n    { icon:'🎟️', label:'Promo codes & discounts', action: doPromos        },\n  ], 120);\n  addBack(220, '↩ Back to main menu', showMainMenu);\n}\nasync function doPaymentMethods(){\n  await bubble('Payment methods','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`We accept all major payment methods:`);\n  showTyping(); await wait(500); removeTyping();\n  await bubble(`💳 Credit & debit cards (Visa, Mastercard, Amex)<br>📱 UPI, Google Pay, PhonePe<br>🏦 Net banking<br>📦 Cash on Delivery (select pincodes)<br>💰 EMI options via Razorpay`);\n  addBack(250);\n}\nasync function doRefundPolicy(){\n  await bubble('Refund policy','user');\n  showTyping(); await wait(950); removeTyping();\n  await bubble(`We offer a <strong>7-day return window<\/strong> from the date of delivery.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`Refunds are processed within <strong>5–7 business days<\/strong> back to your original payment method once the return is received and inspected.`);\n  await bubble(`To initiate a return, please email us 👇`,'bot',300);\n  await addEmail(200);\n  addBack(300);\n}\nasync function doCancelOrder(){\n  await bubble('Cancel an order','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Orders can be cancelled within <strong>12 hours<\/strong> of placing them, before dispatch begins.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`To cancel, please contact us immediately with your order number and we'll sort it right away 👇`);\n  await addEmail(200);\n  addBack(300);\n}\nasync function doPromos(){\n  await bubble('Promo codes & discounts','user');\n  showTyping(); await wait(850); removeTyping();\n  await bubble(`Promo codes can be applied at checkout in the <strong>\"Discount code\"<\/strong> field.`);\n  showTyping(); await wait(500); removeTyping();\n  await bubble(`Subscribe to our email list to get early access to sales and exclusive discount codes. You can sign up right from our website footer! 🎉`);\n  addBack(250);\n}\n\nasync function doShipping(){\n  await bubble('Shipping information','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Happy to help! What would you like to know?`);\n  addMenu([\n    { icon:'⏱️', label:'Delivery timeframes',    action: doDeliveryTime   },\n    { icon:'💸', label:'Shipping costs',         action: doShippingCost   },\n    { icon:'🌍', label:'International delivery', action: doInternational  },\n    { icon:'📍', label:'Track a live shipment',  action: doLiveTrack      },\n  ], 120);\n  addBack(220, '↩ Back to main menu', showMainMenu);\n}\nasync function doDeliveryTime(){\n  await bubble('Delivery timeframes','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Here's our standard delivery schedule:`);\n  showTyping(); await wait(500); removeTyping();\n  await bubble(`🏙️ <strong>Metro cities<\/strong> — 3–5 business days<br>🌆 <strong>Tier 2 cities<\/strong> — 5–7 business days<br>🌄 <strong>Remote areas<\/strong> — 7–10 business days`);\n  addBack(250);\n}\nasync function doShippingCost(){\n  await bubble('Shipping costs','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`We offer <strong>free shipping on all orders above ₹999<\/strong> within India. 🎉`);\n  showTyping(); await wait(500); removeTyping();\n  await bubble(`For orders below ₹999, a flat shipping fee of <strong>₹79<\/strong> applies.`);\n  addBack(250);\n}\nasync function doInternational(){\n  await bubble('International delivery','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`We currently ship to <strong>India, UAE, UK, USA, Canada, and Singapore.<\/strong>`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`International orders typically take <strong>10–15 business days<\/strong> and may be subject to local customs duties. For a shipping quote, please email us 👇`);\n  await addEmail(200);\n  addBack(300);\n}\nasync function doLiveTrack(){\n  await bubble('Track a live shipment','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Once your order is dispatched, you'll receive an SMS and email with your <strong>tracking link<\/strong> directly from our delivery partner.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`If you haven't received a tracking update after 3 business days, please reach out to us 👇`);\n  await addEmail(200);\n  addBack(300);\n}\n\nasync function doReturns(){\n  await bubble('Returns & exchanges','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Size exchanges or returns are not available.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`Please make sure to check your size carefully before placing an order. We have already provided a detailed and accurate size chart on our website, so kindly refer to it and choose your correct size before ordering.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`⚠️ Selecting the wrong size is the customer’s responsibility. In such cases, we will not be able to process any exchange or return.`);\n  addMenu([\n    { icon:'📦', label:'How to return an item',     action: doHowReturn },\n    { icon:'🔁', label:'Exchange for another size', action: doExchange  },\n    { icon:'❓', label:'Non-returnable items',      action: doNonReturn  },\n  ], 120);\n  addBack(220, '↩ Back to main menu', showMainMenu);\n}\nasync function doHowReturn(){\n  await bubble('How to return an item','user');\n  showTyping(); await wait(950); removeTyping();\n  await bubble(`Returns are not available for size issues or wrong-size orders.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`Please review the size chart carefully before ordering. The size chart on our website is already detailed and accurate, so use that to choose the correct size.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`If the wrong size is selected, it is the customer’s responsibility, and we won’t be able to process a return or exchange.`);\n  addBack(300);\n}\nasync function doExchange(){\n  await bubble('Exchange for another size','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Size exchanges are not available.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`Please check the size chart carefully before placing your order. If the wrong size is selected, we will not be able to process an exchange or return.`);\n  showTyping(); await wait(550); removeTyping();\n  await bubble(`The customer is responsible for choosing the correct size before ordering.`);\n  addBack(300);\n}\nasync function doNonReturn(){\n  await bubble('Non-returnable items','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Since size exchanges and returns are not available, please double-check your size before ordering.`);\n  showTyping(); await wait(450); removeTyping();\n  await bubble(`The size chart on our website should be used carefully before purchase. Wrong-size selection cannot be processed as a return or exchange.`);\n  addBack(250);\n}\n\nasync function doContact(){\n  await bubble('Contact support','user');\n  showTyping(); await wait(900); removeTyping();\n  await bubble(`Our team is always happy to help! 😊`);\n  showTyping(); await wait(600); removeTyping();\n  await bubble(`For any queries, please reach us at<br><strong style=\"color:var(--g-accent)\">${SUPPORT_EMAIL}<\/strong>`);\n  await addEmail(200);\n  showTyping(); await wait(600); removeTyping();\n  await bubble(`We typically respond within <strong>2–4 hours<\/strong> on business days.`);\n  addBack(300);\n}\n<\/script>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"custom_liquid_7tgJMD":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["section_dBWwwf","footer_m9NzUG","footer_utilities_jLGE8U","custom_liquid_MgpcPD","custom_liquid_gxVQYf","custom_liquid_7tgJMD"]}