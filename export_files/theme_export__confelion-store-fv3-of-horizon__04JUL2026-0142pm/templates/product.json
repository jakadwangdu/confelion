<\/div>\n        <div class=\"rf-title\">Free Shipping<\/div>\n        <div class=\"rf-desc\">\n          Free shipping on all India order or order above ₹499.00\n        <\/div>\n      <\/div>\n\n      <div class=\"rf-slide\">\n        <div class=\"rf-icon\">💬<\/div>\n        <div class=\"rf-title\">Support Online<\/div>\n        <div class=\"rf-desc\">\n          We support customers 24\/7, send questions we will solve immediately.\n        <\/div>\n      <\/div>\n\n      <div class=\"rf-slide\">\n        <div class=\"rf-icon\">✔️<\/div>\n        <div class=\"rf-title\">7 Days Return<\/div>\n        <div class=\"rf-desc\">\n          Simply return within 7 days. Items must be undamaged.\n        <\/div>\n      <\/div>\n\n      <div class=\"rf-slide\">\n        <div class=\"rf-icon\">💳<\/div>\n        <div class=\"rf-title\">100% Payment Secure<\/div>\n        <div class=\"rf-desc\">\n          Secure payments with Gpay and Paytm.\n        <\/div>\n      <\/div>\n\n    <\/div>\n  <\/div>\n\n  <div class=\"rf-dots\" id=\"rfDots\"><\/div>\n<\/div>\n\n<script>\n(() => {\n  const track = document.getElementById(\"rfTrack\");\n  const slides = document.querySelectorAll(\".rf-slide\");\n  const dotsContainer = document.getElementById(\"rfDots\");\n\n  let index = 0;\n\n  \/\/ create dots\n  slides.forEach((_, i) => {\n    const dot = document.createElement(\"span\");\n    dot.className = \"rf-dot\";\n    if (i === 0) dot.classList.add(\"active\");\n    dotsContainer.appendChild(dot);\n  });\n\n  const dots = document.querySelectorAll(\".rf-dot\");\n\n  function update() {\n    track.style.transform = `translateX(-${index * 100}%)`;\n    dots.forEach(d => d.classList.remove(\"active\"));\n    dots[index].classList.add(\"active\");\n  }\n\n  \/\/ auto slide\n  setInterval(() => {\n    index = (index + 1) % slides.length;\n    update();\n  }, 3000);\n\n})();\n<\/script>","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}},"17796281