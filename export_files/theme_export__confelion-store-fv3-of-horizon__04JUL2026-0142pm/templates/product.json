p-left-radius: var(--pincode-radius);\n    border-bottom-left-radius: var(--pincode-radius);\n    padding: 0 16px;\n    font-size: 16px;\n    color: var(--pincode-black);\n    outline: none;\n  }\n\n  #pincode-button {\n    background-color: var(--pincode-black);\n    color: #ffffff;\n    border: none;\n    border-top-right-radius: var(--pincode-radius);\n    border-bottom-right-radius: var(--pincode-radius);\n    padding: 0 24px;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    letter-spacing: 0.5px;\n    transition: opacity 0.2s;\n  }\n\n  #pincode-button:disabled {\n    opacity: 0.7;\n    cursor: not-allowed;\n  }\n\n  \/* Result Message *\/\n  .pincode-result {\n    background-color: var(--pincode-success-bg);\n    color: var(--pincode-success-text);\n    padding: 14px 16px;\n    border-radius: var(--pincode-radius);\n    font-size: 15px;\n    font-weight: 500;\n    text-align: center;\n    animation: fadeIn 0.3s ease-in-out;\n  }\n\n  .hidden {\n    display: none;\n  }\n\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(-5px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n<\/style>\n\n<script>\n  function checkPincode() {\n    const input = document.getElementById('pincode-input');\n    const button = document.getElementById('pincode-button');\n    const result = document.getElementById('pincode-result');\n\n    if (input.value.length < 5) {\n      alert(\"Please enter a valid pincode\");\n      return;\n    }\n\n    \/\/ Start Loading State\n    button.disabled = true;\n    const originalText = button.innerText;\n    button.innerText = \"...\";\n    result.classList.add('hidden');\n\n    \/\/ Simulate Network Delay (1.5 seconds)\n    setTimeout(() => {\n      button.disabled = false;\n      button.innerText = originalText;\n      \n      \/\/ Show Success Message\n      result.classList.remove('hidden');\n    }, 1500);\n  }\n<\/script>"},"blocks":{}},"custom_liquid_xJ8AMX":{"type":"custom-liquid","name":"t: