w_tab":false,"placeholder":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"custom_liquid_fHYnU7":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<div class=\"sale-container\">\n  <div class=\"sale-badge\">SALE<\/div>\n  <div class=\"sale-timer\">\n    <span class=\"timer-label\">Ends in<\/span>\n    <span id=\"midnight-countdown\">00:00:00<\/span>\n  <\/div>\n<\/div>\n\n<style>\n  .sale-container {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif;\n    margin: 10px 0;\n  }\n\n  \/* The Red Sale Badge from your image *\/\n  .sale-badge {\n    background-color: #ff0000;\n    color: #ffffff;\n    padding: 4px 10px;\n    border-radius: 4px;\n    font-size: 12px;\n    font-weight: 800;\n    text-transform: uppercase;\n    line-height: 1;\n    letter-spacing: 0.5px;\n  }\n\n  \/* The Timer Styles *\/\n  .sale-timer {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    color: #ff0000; \/* Matching red for the clock text *\/\n    font-size: 13px;\n    font-weight: 700;\n  }\n\n  .timer-label {\n    text-transform: uppercase;\n    font-size: 11px;\n    opacity: 0.8;\n  }\n\n  #midnight-countdown {\n    font-variant-numeric: tabular-nums; \/* Prevents text jumping *\/\n    min-width: 65px;\n  }\n<\/style>\n\n<script>\n  function updateISTTimer() {\n    const countdownElement = document.getElementById('midnight-countdown');\n    \n    \/\/ 1. Get current time in IST\n    const now = new Date();\n    const istOffset = 5.5 * 60 * 60 * 1000; \/\/ IST is UTC + 5:30\n    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);\n    const istTime = new Date(utc + istOffset);\n\n    \/\/ 2. Set target to midnight IST\n    const midnightIST = new Date(istTime);\n    midnightIST.setHours(24, 0, 0, 0); \n\n    \/\/ 3. Calculate difference\n    const diff = midnightIST - istTime;\n\n    if (diff <= 0) {\n      countdownElement.innerText = \"00:00:00\";\n      return;\n    }\n\n    \/\/ 4. Format HH:MM:SS\n    const hours = Math.floor((diff \/ (1000 * 60 * 60)) % 24);\n    const minutes = Math.floor((diff \/ (1000 * 60)) % 60);\n    const seconds = Math.floor((diff \/ 1000) % 60);\n\n    const displayH = hours < 10 ? '0' + hours : hours;\n    const displayM = minutes < 10 ? '0' + minutes : minutes;\n    const displayS = seconds < 10 ? '0' + seconds : seconds;\n\n    countdownElement.innerText = `${displayH}:${displayM}:${displayS}`;\n  }\n\n  \/\/ Run immediately and then every second\n  updateISTTimer();\n  setInterval(updateISTTimer, 1000);\n<\/script>"},"blocks":{}},"text_xrnftG":{"type":"text","name":"Product title","settings":{"text":"<h1>{{ closest.product.title }}<\/h1>","width":"100%","max_width":"normal","alignment":"left","type_preset":"h4","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"custom_liquid_QdGzYi":{"type":"custom-liquid","name":"t:names.custom_liquid","settings":{"custom_liquid":"<div id=\"InventoryPill-{{ section.id }}\" \n     class=\"status-pill-container\" \n     data-product-url=\"{{ product.url }}\">\n  {%- assign current_variant = product.selected_or_first_available_variant -%}\n  <div class=\"status-pill {% if current_variant.available %}status-pill--in-stock{% else %}status-pill--out-of-stock{% endif %}\">\n    <span class=\"status-pill__indicator\">\n      <span class=\"status-pill__dot\"><\/span>\n      <span class=\"status-pill__pulse\"><\/span>\n    <\/span>\n    <span class=\"status-pill__text\">\n      {% if current_variant.available %}In Stock{% else %}Out of Stock{% endif %}\n    <\/span>\n  <\/div>\n<\/div>\n\n<style>\n  .status-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 6px 12px;\n    border-radius: 50px;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 600;\n    line-height: 1;\n    width: fit-content;\n    margin: 10px 0;\n    transition: background 0.2s ease;\n  }\n\n  \/* In Stock: Green Pill + Green Pulse *\/\n  .status-pill--in-stock {\n    background-color: #f0fdf4;\n    border: 1px solid #bbf7d0;\n    color: #166534;\n  }\n  .status-pill--in-stock .status-pill__dot,\n  .status-pill--in-stock .status-pill__pulse {\n    background-color: #22c55e;\n  }\n  .status-pill--in-stock .status-pill__pulse {\n    position: absolute;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    z-index: 1;\n    opacity: 0.6;\n    animation: pillPulse 2s infinite;\n  }\n\n  \/* Out of Stock: Red Pill, No Pulse *\/\n  .status-pill--out-of-stock {\n    background-color: #fef2f2;\n    border: 1px solid #fecaca;\n    color: #991b1b;\n  }\n  .status-pill--out-of-stock .status-pill__dot {\n    background-color: #ef4444;\n  }\n  .status-pill--out-of-stock .status-pill__pulse {\n    display: none;\n  }\n\n  \/* Indicator Core *\/\n  .status-pill__indicator {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 8px;\n    height: 8px;\n  }\n  .status-pill__dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    z-index: 2;\n  }\n\n  @keyframes pillPulse {\n    0% { transform: scale(1); opacity: 0.6; }\n    70% { transform: scale(2.5); opacity: 0; }\n    100% { transform: scale(1); opacity: 0; }\n  }\n<\/style>\n\n<script>\n(function() {\n  const updatePill = () => {\n    const urlParams = new URLSearchParams(window.location.search);\n    const variantId = urlParams.get('variant');\n    const container = document.querySelector('.status-pill-container');\n    if (!container) return;\n\n    const productPath = container.getAttribute('data-product-url').split('?')[0];\n\n    fetch(`${productPath}.js`)\n      .then(response => response.json())\n      .then(product => {\n        \/\/ If no variant in URL, use the first one\n        const currentVariant = variantId \n          ? product.variants.find(v => v.id == variantId) \n          : product.variants[0];\n\n        const pill = container.querySelector('.status-pill');\n        const text = container.querySelector('.status-pill__text');\n\n        if (currentVariant && currentVariant.available) {\n          pill.className = 'status-pill status-pill--in-stock';\n          text.textContent = 'In Stock';\n        } else {\n          pill.className = 'status-pill status-pill--out-of-stock';\n          text.textContent = 'Out of Stock';\n        }\n      })\n      .catch(err => console.error('Pill update error:', err));\n  };\n\n  \/\/ 1. Listen for URL changes (Browser Back\/Forward)\n  window.addEventListener('popstate', updatePill);\n\n  \/\/ 2. Watch the URL for changes (When theme updates variant via AJAX)\n  let lastUrl = location.href;\n  new MutationObserver(() => {\n    if (location.href !== lastUrl) {\n      lastUrl = location.href;\n      updatePill();\n    }\n  }).observe(document, { subtree: true, childList: true });\n\n  \/\/ 3. Run once on load\n  updatePill();\n})();\n<\/script>"},"blocks":{}},"price_tVjtKg":{"type":"price","settings":{"show_sale_price_first":true,"show_installments":false,"show_tax_info":false,"type_preset":"h4","width":"100%","alignment":"left","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","color":"var(--color-foreground)","padding-block-start":4,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["custom_liquid_fHYnU7","text_xrnftG","custom_liquid_QdGzYi","price_tVjtKg"]},"divider_VJhene":{"type":"_divider","name":"t:names.divider","settings":{"thickness":1,"corner_radius":"square","width_percent":10