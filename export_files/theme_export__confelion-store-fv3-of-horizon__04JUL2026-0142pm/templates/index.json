t-backdrop-filter: blur(5px);\n  }\n\n  .cf-popup-overlay.cf-popup-visible {\n    display: flex;\n  }\n\n  .cf-popup-card {\n    position: relative;\n    display: grid;\n    grid-template-columns: 0.95fr 1.05fr;\n    width: min(780px, 100%);\n    min-height: 430px;\n    overflow: hidden;\n    background: #f8f7f4;\n    border: 1px solid rgba(0, 0, 0, 0.08);\n    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.28);\n    animation: cfPopupEnter 0.36s ease both;\n  }\n\n  .cf-popup-close {\n    position: absolute;\n    top: 16px;\n    right: 16px;\n    z-index: 3;\n    display: grid;\n    width: 36px;\n    height: 36px;\n    padding: 0;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    border-radius: 50%;\n    place-items: center;\n    cursor: pointer;\n    background: rgba(255, 255, 255, 0.88);\n    transition: transform 0.2s ease, background 0.2s ease;\n  }\n\n  .cf-popup-close:hover {\n    transform: rotate(90deg);\n    background: #ffffff;\n  }\n\n  .cf-popup-close svg {\n    width: 17px;\n    height: 17px;\n    fill: none;\n    stroke: #111111;\n    stroke-linecap: round;\n    stroke-width: 1.6;\n  }\n\n  .cf-popup-image {\n    position: relative;\n    min-height: 430px;\n    overflow: hidden;\n    background: #171717;\n  }\n\n  .cf-popup-image img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .cf-popup-image-fallback {\n    background:\n      linear-gradient(145deg, rgba(255,255,255,0.04), rgba(255,255,255,0)),\n      linear-gradient(135deg, #232323 0%, #070707 100%);\n  }\n\n  .cf-image-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(\n      180deg,\n      rgba(0, 0, 0, 0.08) 25%,\n      rgba(0, 0, 0, 0.58) 100%\n    );\n  }\n\n  .cf-image-brand {\n    position: absolute;\n    left: 24px;\n    bottom: 23px;\n    z-index: 1;\n    color: #ffffff;\n  }\n\n  .cf-image-brand span {\n    display: block;\n    font-size: 21px;\n    font-weight: 700;\n    letter-spacing: 3px;\n  }\n\n  .cf-image-brand small {\n    display: block;\n    margin-top: 7px;\n    font-size: 9px;\n    letter-spacing: 2.2px;\n    opacity: 0.72;\n  }\n\n  .cf-popup-content {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 54px 46px 42px;\n    color: #121212;\n  }\n\n  .cf-popup-eyebrow {\n    margin-bottom: 15px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 2.3px;\n    color: #6f6d67;\n  }\n\n  .cf-popup-content h2 {\n    margin: 0 0 15px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(36px, 4vw, 48px);\n    font-weight: 500;\n    line-height: 0.98;\n    letter-spacing: -1.4px;\n    color: #111111;\n  }\n\n  .cf-popup-content p {\n    margin: 0 0 27px;\n    max-width: 320px;\n    font-family: Arial, sans-serif;\n    font-size: 14px;\n    line-height: 1.65;\n    color: #595854;\n  }\n\n  .cf-popup-primary {\n    display: flex;\n    width: 100%;\n    min-height: 52px;\n    box-sizing: border-box;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 13px 18px;\n    background: #111111;\n    color: #ffffff;\n    font-family: Arial, sans-serif;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.2px;\n    text-decoration: none;\n    transition: transform 0.2s ease, background 0.2s ease;\n  }\n\n  .cf-popup-primary:hover {\n    transform: translateY(-2px);\n    background: #292929;\n  }\n\n  .cf-instagram-icon {\n    width: 18px;\n    height: 18px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.7;\n  }\n\n  .cf-popup-secondary {\n    margin-top: 17px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: #6e6c67;\n    cursor: pointer;\n    font-family: Arial, sans-serif;\n    font-size: 12px;\n    text-decoration: underline;\n    text-underline-offset: 4px;\n  }\n\n  @keyframes cfPopupEnter {\n    from {\n      opacity: 0;\n      transform: translateY(18px) scale(0.985);\n    }\n\n    to {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n    }\n  }\n\n  @media (max-width: 640px) {\n    .cf-popup-overlay {\n      align-items: flex-end;\n      padding: 0;\n      background: rgba(0, 0, 0, 0.42);\n    }\n\n    .cf-popup-card {\n      display: block;\n      width: 100%;\n      min-height: auto;\n      border: 0;\n      border-radius: 18px 18px 0 0;\n      animation: cfPopupMobileEnter 0.34s ease both;\n    }\n\n    .cf-popup-close {\n      top: 13px;\n      right: 13px;\n      width: 34px;\n      height: 34px;\n    }\n\n    .cf-popup-image {\n      min-height: 190px;\n      max-height: 220px;\n    }\n\n    .cf-image-brand {\n      left: 19px;\n      bottom: 17px;\n    }\n\n    .cf-image-brand span {\n      font-size: 17px;\n      letter-spacing: 2.5px;\n    }\n\n    .cf-image-brand small {\n      font-size: 8px;\n    }\n\n    .cf-popup-content {\n      padding: 25px 21px 24px;\n    }\n\n    .cf-popup-eyebrow {\n      margin-bottom: 11px;\n      font-size: 9px;\n      letter-spacing: 2px;\n    }\n\n    .cf-popup-content h2 {\n      margin-bottom: 10px;\n      font-size: 35px;\n    }\n\n    .cf-popup-content p {\n      margin-bottom: 20px;\n      max-width: none;\n      font-size: 13.5px;\n      line-height: 1.55;\n    }\n\n    .cf-popup-primary {\n      min-height: 50px;\n    }\n\n    .cf-popup-secondary {\n      margin-top: 15px;\n    }\n\n    @keyframes cfPopupMobileEnter {\n      from {\n        opacity: 0;\n        transform: translateY(34px);\n      }\n\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n  }\n<\/style>\n\n<script>\n  (function () {\n    const popup = document.getElementById(\"cfIgPopup\");\n    const storageKey = \"cfInstagramPopupLastShown\";\n    const repeatAfterDays = 3;\n    const delayInMilliseconds = 3500;\n\n    if (!popup) return;\n\n    function shouldShowPopup() {\n      const lastShown = localStorage.getItem(storageKey);\n\n      if (!lastShown) return true;\n\n      const elapsedTime = Date.now() - Number(lastShown);\n      const repeatDelay = repeatAfterDays * 24 * 60 * 60 * 1000;\n\n      return elapsedTime > repeatDelay;\n    }\n\n    function showCfPopup() {\n      popup.classList.add(\"cf-popup-visible\");\n      popup.setAttribute(\"aria-hidden\", \"false\");\n    }\n\n    window.markCfPopupSeen = function () {\n      localStorage.setItem(storageKey, String(Date.now()));\n    };\n\n    window.closeCfPopup = function () {\n      popup.classList.remove(\"cf-popup-visible\");\n      popup.setAttribute(\"aria-hidden\", \"true\");\n      markCfPopupSeen();\n    };\n\n    popup.addEventListener(\"click\", function (event) {\n      if (event.target === popup) {\n        closeCfPopup();\n      }\n    });\n\n    document.addEventListener(\"keydown\", function (event) {\n      if (event.key === \"Escape\") {\n        closeCfPopup();\n      }\n    });\n\n    if (shouldShowPopup()) {\n      setTimeout(showCfPopup, delayInMilliseconds);\n    }\n  })();\n<\/script>","color_scheme":"","section_width":"page-width","padding-block-start":0,"padding-block-end":0}}},"order":["hero_jVaWmY","custom_liquid_Yrz8Ew","custom_liquid_beT9Ea","17739240208c4a5318","custom_liquid_6LWmJg","divider_QqgxzD","1773924308ae58390d","divider_kimDmf","custom_liquid_xWL3Fp","section_kcTYyh","custom_liquid_PYJ3zw","custom_liquid_tzMX7T"]}